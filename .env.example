# Server-side (used by /api/chat.ts serverless fn + Node scripts)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-3-small

PINECONE_API_KEY=pcsk_...
PINECONE_HOST=https://your-index-xxxx.svc.region.pinecone.io
PINECONE_INDEX_NAME=libby-chat-bot
PINECONE_ENVIRONMENT=us-east-1

# Legacy VITE_ copies (only needed for local indexing scripts: index-documents.js, crawl-ou-library.js)
VITE_OPENAI_API_KEY=sk-...
VITE_OPENAI_MODEL=gpt-3.5-turbo
VITE_EMBEDDING_MODEL=text-embedding-3-small
VITE_PINECONE_API_KEY=pcsk_...
VITE_PINECONE_HOST=https://your-index-xxxx.svc.region.pinecone.io
VITE_PINECONE_INDEX_NAME=libby-chat-bot
VITE_PINECONE_ENVIRONMENT=us-east-1
